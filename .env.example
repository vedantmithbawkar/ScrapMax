# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Gemini Vision API for Real AI Scrap Classification & Quality Inspection
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Razorpay / UPI Instant Payout Payment API
PAYMENT_API_KEY=your_payment_api_key_here
NEXT_PUBLIC_PAYMENT_API_KEY=your_payment_api_key_here

# UIDAI Aadhaar Verification API Configuration (SurePass / Cashfree / Sandbox UIDAI e-KYC)
AADHAAR_API_KEY=your_aadhaar_api_key_here
AADHAAR_API_SECRET=your_aadhaar_api_secret_here
AADHAAR_API_URL=https://api.surepass.io/api/v1/aadhaar-v2/generate-otp
AADHAAR_SANDBOX_MODE=true

# Live Mobile SMS Gateway (Choose one if sending carrier SMS to phones)
# Option A: Fast2SMS (India Quick OTP)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Option B: Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Option C: Msg91
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here

# Dedicated Admin Portal Authentication (Vercel & Local)
ADMIN_EMAIL=admin@scrapmax.gov.in
ADMIN_PASSWORD=your_admin_password_here
ADMIN_SECONDARY_EMAIL=admin@scrapmax.com
ADMIN_SECONDARY_PASSWORD=your_secondary_password_here

